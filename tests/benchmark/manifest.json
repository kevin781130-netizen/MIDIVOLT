{
  "schema_version": "1.0.0",
  "project": "MIDIVOLT",
  "purpose": "Reproducible audio-to-MIDI benchmark manifest",
  "status": "empty_template",
  "rules": {
    "split_unit": "source_song",
    "preserve_original_timeline": true,
    "require_reference_midi": true,
